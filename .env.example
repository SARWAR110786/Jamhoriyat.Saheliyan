# ─────────────────────────────────────────────────────────────────────────────
#  Copy to `.env.local` for local development, or set these in the hosting
#  dashboard (Vercel / Netlify / your server) for production.
# ─────────────────────────────────────────────────────────────────────────────

# ── Contact form ─────────────────────────────────────────────────────────────
# Where contact-form submissions are forwarded. Anything that accepts a JSON
# POST works: a Slack/Teams webhook, an n8n webhook, Resend, Postmark, Formspark.
#
# If this is NOT set, the API validates the message but refuses to accept it in
# production (it returns an error asking the sender to email directly), so no
# message is silently lost. In development it is logged to the server console.
CONTACT_WEBHOOK_URL=

# Fallback address shown to the sender if delivery fails.
CONTACT_INBOX=hello@jamhooriyatsaheliyan.org

# ── Public site URL ──────────────────────────────────────────────────────────
# Used for canonical links, Open Graph URLs, sitemap entries and JSON-LD @id.
# Set to the real domain before launch, then rebuild: NEXT_PUBLIC_ values are
# inlined at build time.
NEXT_PUBLIC_SITE_URL=https://jamhooriyatsaheliyan.org
